# Copia este archivo a .env.server en el Ubuntu Server y ajusta los valores.

DEBUG=false
SECRET_KEY=change-this-in-ubuntu

# Hostnames o IPs reales por donde entrara SysLab a traves del proxy central.
# Ejemplo LAN validado: acceso por IP y opcionalmente por syslab.lan.
ALLOWED_HOSTS=syslab.lan,192.168.1.149,localhost,127.0.0.1,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=http://192.168.1.149,http://syslab.lan,http://localhost,https://*.trycloudflare.com

# En LAN por HTTP, ambos quedan en 0.
# Si mas adelante publicas SysLab por HTTPS real, cambia ambos a 1.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Puerto interno publicado solo en localhost para que el Caddy central del host haga reverse proxy.
SERVER_HTTP_BIND_HOST=127.0.0.1
SERVER_HTTP_PORT=18080

# Runtime AWS recomendado: perfil local del host montado en ~/.aws
# En modo server, backend y celery leen estas variables directamente desde
# .env.server. Si cambias el perfil o la region, recrea el stack con:
#   docker compose -f tools/docker/compose.server.yml down
#   docker compose -f tools/docker/compose.server.yml up -d
# En Cloud Connections con AssumeRole, este perfil es la identidad base
# que el backend usa para llamar sts:AssumeRole.
AWS_PROFILE=tesis
AWS_DEFAULT_REGION=us-east-1

# Si luego habilitas Google login en este servidor, completa este valor.
VITE_GOOGLE_CLIENT_ID=
