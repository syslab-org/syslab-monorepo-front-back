# Copia este archivo a .env.server en el Ubuntu Server y ajusta los valores.

DEBUG=false
SECRET_KEY=change-this-in-ubuntu

# Acceso por LAN al servidor actual.
ALLOWED_HOSTS=192.168.1.149,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.1.149,http://localhost

# En esta etapa el acceso es por HTTP LAN, no HTTPS.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Runtime AWS recomendado: perfil local del host montado en ~/.aws
AWS_PROFILE=tesis
AWS_DEFAULT_REGION=us-east-1

# Si luego habilitas Google login en este servidor, completa este valor.
VITE_GOOGLE_CLIENT_ID=
