# Copia este archivo a .env.server en el Ubuntu Server y ajusta los valores.

DEBUG=false
SECRET_KEY=change-this-in-ubuntu

# Hostnames o dominios reales por donde entrara SysLab a traves del proxy central.
ALLOWED_HOSTS=syslab.lan,syslab.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://syslab.example.com,http://syslab.lan,http://localhost

# Si el proxy central expone HTTPS al exterior, habilita ambos en 1.
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# Puerto interno publicado solo en localhost para que el Caddy central del host haga reverse proxy.
SERVER_HTTP_BIND_HOST=127.0.0.1
SERVER_HTTP_PORT=18080

# Runtime AWS recomendado: perfil local del host montado en ~/.aws
AWS_PROFILE=tesis
AWS_DEFAULT_REGION=us-east-1

# Si luego habilitas Google login en este servidor, completa este valor.
VITE_GOOGLE_CLIENT_ID=
