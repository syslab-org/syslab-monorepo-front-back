# apps/backend/provisioning/templates/main.tf.j2
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

{# --- Detectar simulate_only con fallback seguro --- #}
{% set sim = true %}
{% if simulate_only is defined %}
  {% set sim = simulate_only %}
{% elif payload is defined and payload.simulate_only is defined %}
  {% set sim = payload.simulate_only %}
{% endif %}

{% if sim %}
# ---- MODO SIMULACIÓN ----
provider "aws" {
  region                      = var.region
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
  skip_requesting_account_id  = true
  access_key                  = "DUMMY"
  secret_key                  = "DUMMY"
}
{% else %}
# ---- MODO REAL (IAM Role/credenciales del entorno) ----
provider "aws" {
  region = var.region
}
{% endif %}



resource "aws_vpc" "this" {
  cidr_block = var.vpc_cidr
  tags = {
    Name = var.name
  }
}

locals {
  subnets = var.subnets
}

resource "aws_subnet" "this" {
  for_each                = { for s in local.subnets : s.name => s }
  vpc_id                  = aws_vpc.this.id
  cidr_block              = each.value.cidr
  availability_zone       = each.value.az
  map_public_ip_on_launch = each.value.public
  tags = {
    Name = each.key
  }
}

# Sólo se crea IGW si existe al menos una subnet pública
resource "aws_internet_gateway" "igw" {
  count = var.has_public ? 1 : 0
  vpc_id = aws_vpc.this.id
  tags = {
    Name = "${var.name}-igw"
  }
}
