# apps/backend/provisioning/templates/main.tf.j2
terraform {
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
}

{# Bind seguro #}
{% set sim = payload.simulate_only if payload is defined and payload.simulate_only is defined
            else simulate_only|default(true) %}

{# Región: usa VLAN.region o 1ª VPC.region; si viene con AZ (us-east-1a) cortamos la letra final #}
{% set raw_region = (payload.vlan.region if payload and payload.vlan and payload.vlan.region
                     else (payload.vpcs[0].region if payload and payload.vpcs else "us-east-1")) %}
{% set norm_region = (raw_region[:-1] if raw_region and (raw_region|string)[-1].isalpha() else raw_region) %}

provider "aws" {
  region = {{ norm_region | tojson }}
  {% if sim %}
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
  skip_requesting_account_id  = true
  access_key = "DUMMY"
  secret_key = "DUMMY"
  {% endif %}
}

# -------- Datos del plan en locals (desde el payload) ------------------------
locals {
  vpcs     = {{ (payload.vpcs   if payload and payload.vpcs   else []) | tojson }}
  links    = {{ (payload.links  if payload and payload.links  else []) | tojson }}
  routers  = {{ (payload.routers if payload and payload.routers else []) | tojson }}

  # Routers tipo TGW (Transit Gateway)
  tgw_routers = [ for r in local.routers : r if try(lower(r.type), "") == "tgw" ]
}

# -------- VPCs ---------------------------------------------------------------
resource "aws_vpc" "vpc" {
  for_each   = { for v in local.vpcs : v.id => v }
  cidr_block = each.value.cidr_block
  tags       = { Name = each.value.name }
}

# Subnets (flatten)
locals {
  all_subnets = flatten([
    for v in local.vpcs : [
      for sn in coalesce(v.subnets, []) : {
        key  = "${v.id}:${sn.name}"
        vpc  = v.id
        data = sn
      }
    ]
  ])
  subnet_map = { for s in local.all_subnets : s.key => s }

  # Mapa de subnets por VPC y nombre (para resolver attachments por nombre)
  subnets_by_vpc = {
    for v in local.vpcs : v.id => { for s in coalesce(v.subnets, []) : s.name => s }
  }
}

# SSH flags por VPC
locals {
  vpc_has_ssh = {
    for v in local.vpcs : v.id => anytrue([
      for sn in coalesce(v.subnets, []) : anytrue([
        for inst in coalesce(sn.instances, []) :
        length(trimspace(try(inst.ssh_access, ""))) > 0
      ])
    ])
  }
  vpc_ssh_cidr = { for v in local.vpcs : v.id => coalesce(try(v.allowed_ssh_cidr, ""), "") }
}

resource "aws_subnet" "this" {
  for_each                = { for s in local.all_subnets : s.key => s }
  vpc_id                  = aws_vpc.vpc[each.value.vpc].id
  cidr_block              = each.value.data.cidr_block
  availability_zone       = each.value.data.availability_zone
  map_public_ip_on_launch = try(each.value.data.map_public_ip_on_launch, false)
  tags = { Name = each.value.data.name }
}

# Instancias (solo en deploy real; en sim se renderiza pero no se usa AMI)
locals {
  instances_by_subnet = { for s in local.all_subnets : s.key => coalesce(s.data.instances, []) }
  all_instances = flatten([
    for s in local.all_subnets : [
      for inst in local.instances_by_subnet[s.key] : {
        subnet_key          = s.key
        vpc_id_key          = s.vpc
        name                = try(inst.name, "vm-${s.key}")
        instance_type       = try(inst.instance_type, "t2.micro")
        ami                 = try(inst.ami, null)
        ssh_access          = try(inst.ssh_access, null)
        ip_address          = try(inst.ip_address, null)
        associate_public_ip = try(inst.associate_public_ip, true)
      }
    ]
  ])
  inst_map = { for i in local.all_instances : "${i.vpc_id_key}:${i.name}" => i }
}

{% if not sim %}
data "aws_ssm_parameter" "al2023_ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-6.1-x86_64"
}
locals { default_ami_id = data.aws_ssm_parameter.al2023_ami.value }

# === SG para VMs ===
resource "aws_security_group" "vm_sg" {
  for_each = {
    for v in local.vpcs : v.id => v
    if length([for sn in coalesce(v.subnets, []) : sn if length(coalesce(sn.instances, [])) > 0]) > 0
  }

  name        = "${each.value.name}-vm-sg"
  description = "Security group for VMs in ${each.value.name}"
  vpc_id      = aws_vpc.vpc[each.key].id

  # SSH solo si hay instancias que lo pidan y diste CIDR
  dynamic "ingress" {
    for_each = (local.vpc_has_ssh[each.key] && length(trimspace(local.vpc_ssh_cidr[each.key])) > 0) ? [1] : []
    content {
      description = "SSH"
      from_port   = 22
      to_port     = 22
      protocol    = "tcp"
      cidr_blocks = [local.vpc_ssh_cidr[each.key]]
    }
  }

  # ICMP entre VPCs del plan (para ping)
  dynamic "ingress" {
    for_each = local.vpcs
    content {
      description = "ICMP"
      from_port   = -1
      to_port     = -1
      protocol    = "icmp"
      cidr_blocks = [ingress.value.cidr_block]
    }
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${each.value.name}-vm-sg" }
}

resource "aws_instance" "vm" {
  for_each = local.inst_map

  ami                         = coalesce(each.value.ami, local.default_ami_id)
  instance_type               = each.value.instance_type
  subnet_id                   = aws_subnet.this[each.value.subnet_key].id
  associate_public_ip_address = each.value.associate_public_ip
  private_ip                  = each.value.ip_address
  key_name                    = each.value.ssh_access
  vpc_security_group_ids      = [aws_security_group.vm_sg[each.value.vpc_id_key].id]

  tags = { Name = each.value.name }
}
{% endif %}

# =========================
# IGW / NAT / ROUTE TABLES
# =========================

# IGW si la VPC lo requiere (flag internet_gateway o alguna ruta target=igw)
locals {
  vpc_needs_igw = {
    for v in local.vpcs : v.id => (
      try(v.internet_gateway, false) ||
      try(anytrue([ for rt in coalesce(v.route_tables, []) :
        anytrue([ for r in coalesce(rt.routes, []) : lower(try(r.target, "")) == "igw" ])
      ]), false)
    )
  }
}

resource "aws_internet_gateway" "igw" {
  for_each = { for v in local.vpcs : v.id => v if local.vpc_needs_igw[v.id] }
  vpc_id   = aws_vpc.vpc[each.key].id
  tags     = { Name = "${each.value.name}-igw" }
}

# --- NAT Gateway opcional por VPC ---
locals {
  vpc_nat_enabled     = { for v in local.vpcs : v.id => try(v.nat_gateway.enabled, false) }
  vpc_nat_pub_subnet  = { for v in local.vpcs : v.id => try(v.nat_gateway.public_subnet, "") }
}

# Creamos un EIP para cada VPC con NAT habilitado (simple: 1:1)
resource "aws_eip" "nat_eip" {
  for_each = { for v in local.vpcs : v.id => v if local.vpc_nat_enabled[v.id] && length(trimspace(local.vpc_nat_pub_subnet[v.id])) > 0 }
  domain   = "vpc"
  tags     = { Name = "${each.value.name}-nat-eip" }
}

resource "aws_nat_gateway" "nat" {
  for_each = { for v in local.vpcs : v.id => v if local.vpc_nat_enabled[v.id] && length(trimspace(local.vpc_nat_pub_subnet[v.id])) > 0 }
  subnet_id     = aws_subnet.this["${each.key}:${local.vpc_nat_pub_subnet[each.key]}"].id
  allocation_id = aws_eip.nat_eip[each.key].id
  tags          = { Name = "${each.value.name}-nat" }

  depends_on = [aws_internet_gateway.igw]
}

# --- ROUTE TABLES ---

# RT por defecto de cada VPC (para subnets que no especifiquen otra)
resource "aws_route_table" "rt_main" {
  for_each = { for v in local.vpcs : v.id => v }
  vpc_id   = aws_vpc.vpc[each.key].id
  tags     = { Name = "${each.value.name}-rt" }
}

# RT definidas por nombre (si vienen en el payload)
resource "aws_route_table" "rt_named" {
  for_each = {
    for v in local.vpcs :
    for rt in coalesce(v.route_tables, []) :
    "${v.id}:${rt.name}" => {
      vpc = v.id
      vname = v.name
      rt = rt
    }
  }
  vpc_id = aws_vpc.vpc[each.value.vpc].id
  tags   = { Name = "${each.value.vname}-${each.value.rt.name}" }
}

# Asociación de subnets a su RT (si subnet.route_table no viene, usa rt_main)
resource "aws_route_table_association" "assoc" {
  for_each = { for s in local.all_subnets : s.key => s }
  subnet_id = aws_subnet.this[each.key].id
  route_table_id = coalesce(
    try(aws_route_table.rt_named["${each.value.vpc}:${each.value.data.route_table}"].id, null),
    aws_route_table.rt_main[each.value.vpc].id
  )
}

# Ruta default a IGW en el rt_main si la VPC lo requiere (retrocompatible)
resource "aws_route" "igw_default" {
  for_each               = aws_internet_gateway.igw
  route_table_id         = aws_route_table.rt_main[each.key].id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.igw[each.key].id
}

# Rutas dentro de cada RT nombrada
# target soportado: igw | nat | tgw | (local/ninguno) -> solo dest_cidr
resource "aws_route" "rt_named_routes" {
  for_each = {
    for v in local.vpcs :
    for rt in coalesce(v.route_tables, []) :
    for r in coalesce(rt.routes, []) :
    "${v.id}:${rt.name}:${r.name}" => {
      v_id = v.id
      rt_name = rt.name
      route = r
    }
  }

  route_table_id = aws_route_table.rt_named["${each.value.v_id}:${each.value.rt_name}"].id

  destination_cidr_block = try(each.value.route.dest_cidr, null)

  gateway_id         = try(lower(each.value.route.target) == "igw" ? aws_internet_gateway.igw[each.value.v_id].id : null, null)
  nat_gateway_id     = try(lower(each.value.route.target) == "nat" ? aws_nat_gateway.nat[each.value.v_id].id : null, null)
  transit_gateway_id = try(lower(each.value.route.target) == "tgw" ? aws_ec2_transit_gateway.tgw[0].id : null, null)
}

# =========================
# TRANSIT GATEWAY (opcional)
# =========================

# Crea UN TGW si hay al menos un router type=tgw
resource "aws_ec2_transit_gateway" "tgw" {
  count       = length(local.tgw_routers) > 0 ? 1 : 0
  description = try(local.tgw_routers[0].name, "core-tgw")
  tags        = { Name = try(local.tgw_routers[0].name, "core-tgw") }
}

# Links tipo tgw-attach
locals {
  tgw_links = [ for l in local.links : l if try(lower(l.type), "") == "tgw-attach" ]
}

resource "aws_ec2_transit_gateway_vpc_attachment" "tgw_attach" {
  for_each = {
    for l in local.tgw_links :
    "${l.router_id}:${l.vpc_id}" => l
  }

  transit_gateway_id = aws_ec2_transit_gateway.tgw[0].id
  vpc_id             = aws_vpc.vpc[each.value.vpc_id].id
  subnet_ids         = [
    for sn in coalesce(each.value.subnet_names, []) :
    aws_subnet.this["${each.value.vpc_id}:${sn}"].id
  ]

  tags = { Name = "tgw-attach-${each.value.vpc_id}" }
}

# ==========
# PEERING
# ==========
locals { vpc_by_id = { for v in local.vpcs : v.id => v } }
locals { peering_links = [ for l in local.links : l if try(lower(l.type), "") == "peering" ] }

resource "aws_vpc_peering_connection" "peer" {
  for_each    = { for l in local.peering_links : "${l.vpc_a_id}--${l.vpc_b_id}" => l }
  vpc_id      = aws_vpc.vpc[each.value.vpc_a_id].id
  peer_vpc_id = aws_vpc.vpc[each.value.vpc_b_id].id
  auto_accept = true
  tags        = { Name = "peer-${each.value.vpc_a_id}-${each.value.vpc_b_id}" }
}

resource "aws_route" "peer_a_to_b" {
  for_each = { for l in local.peering_links : "a-${l.vpc_a_id}-${l.vpc_b_id}" => l }
  route_table_id            = aws_route_table.rt_main[each.value.vpc_a_id].id
  destination_cidr_block    = local.vpc_by_id[each.value.vpc_b_id].cidr_block
  vpc_peering_connection_id = aws_vpc_peering_connection.peer["${each.value.vpc_a_id}--${each.value.vpc_b_id}"].id
}

resource "aws_route" "peer_b_to_a" {
  for_each = { for l in local.peering_links : "b-${l.vpc_a_id}-${l.vpc_b_id}" => l }
  route_table_id            = aws_route_table.rt_main[each.value.vpc_b_id].id
  destination_cidr_block    = local.vpc_by_id[each.value.vpc_a_id].cidr_block
  vpc_peering_connection_id = aws_vpc_peering_connection.peer["${each.value.vpc_a_id}--${each.value.vpc_b_id}"].id
}
