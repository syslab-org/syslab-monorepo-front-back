# apps/backend/provisioning/templates/main.tf.j2
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

{# ---------------------- Config base ---------------------- #}
{% set sim = (
  payload.get('simulate_only')
  if payload is defined and payload is mapping and payload.get('simulate_only') is not none
  else simulate_only|default(true)
) %}

# Región (normalizada sin sufijo AZ)
{% set raw_region = (
  payload.get('vlan', {}).get('region')
  if payload is defined and payload is mapping and payload.get('vlan')
  else (
    payload.get('vpcs', [])[0].get('region')
    if payload is defined and payload is mapping and (payload.get('vpcs') or [])
    else "us-east-1"
  )
) %}
{% set norm_region = (raw_region[:-1] if raw_region and (raw_region|string)[-1].isalpha() else raw_region) %}

provider "aws" {
  region = {{ norm_region | tojson }}
  {% if sim %}
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
  skip_requesting_account_id  = true
  access_key = "DUMMY"
  secret_key = "DUMMY"
  {% endif %}
}

# -------- Datos del plan en locals (desde el payload) ------------------------
locals {
  vpcs     = {{ ((payload.get('vpcs', [])   if payload is mapping else []) | tojson) }}
  links    = {{ ((payload.get('links', [])  if payload is mapping else []) | tojson) }}
  routers  = {{ ((payload.get('routers', []) if payload is mapping else []) | tojson) }}

  # Routers tipo TGW (Transit Gateway)
  tgw_routers = [for r in local.routers : r if try(lower(r.type), "") == "tgw"]

  # ¿Se permite ICMP entre VPCs conectadas?
  # Regla: si viene explícito en el payload, se respeta.
  # Si NO viene, se enciende automáticamente cuando existan links (peering o tgw-attach).
  allow_cross_vpc_ping = (
    {% if payload is mapping and (payload.get('allow_cross_vpc_ping') is not none) -%}
    {{ payload.get('allow_cross_vpc_ping') | tojson }}
    {%- else -%}
    length([for l in local.links : l if contains(["peering","tgw-attach"], lower(try(l.type, "")))]) > 0
    {%- endif -%}
  )

  # Conjunto de links TGW
  tgw_links = [for l in local.links : l if try(lower(l.type), "") == "tgw-attach"]

  # Mapa rápido por ID
  vpc_by_id = { for v in local.vpcs : v.id => v }
}

# -------- VPCs ---------------------------------------------------------------
resource "aws_vpc" "vpc" {
  for_each   = { for v in local.vpcs : v.id => v }
  cidr_block = each.value.cidr_block
  tags       = { Name = each.value.name }
}

# ---------------------- SUBNETS ----------------------
locals {
  all_subnets = flatten([
    for v in local.vpcs : [
      for sn in coalesce(v.subnets, []) : {
        key  = "${v.id}:${sn.name}"
        vpc  = v.id
        data = sn
      }
    ]
  ])
}

resource "aws_subnet" "this" {
  for_each                = { for s in local.all_subnets : s.key => s }
  vpc_id                  = aws_vpc.vpc[each.value.vpc].id
  cidr_block              = each.value.data.cidr_block
  availability_zone       = each.value.data.availability_zone
  map_public_ip_on_launch = try(each.value.data.map_public_ip_on_launch, false)
  tags = { Name = each.value.data.name }
}

# ---------------------- INSTANCIAS ----------------------
locals {
  instances_by_subnet = { for s in local.all_subnets : s.key => coalesce(s.data.instances, []) }
  all_instances = flatten([
    for s in local.all_subnets : [
      for inst in local.instances_by_subnet[s.key] : {
        subnet_key          = s.key
        vpc_id_key          = s.vpc
        name                = try(inst.name, "vm-${s.key}")
        instance_type       = try(inst.instance_type, "t2.micro")
        ami                 = try(inst.ami, null)
        ssh_access          = try(inst.ssh_access, null)
        ip_address          = try(inst.ip_address, null)
        associate_public_ip = try(inst.associate_public_ip, true)
      }
    ]
  ])
  inst_map = { for i in local.all_instances : "${i.vpc_id_key}:${i.name}" => i }
}

{% if not sim %}
# ---------------------- AMI base ----------------------
data "aws_ssm_parameter" "al2023_ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-6.1-x86_64"
}
locals { default_ami_id = data.aws_ssm_parameter.al2023_ami.value }

# ---------------------- SECURITY GROUPS ----------------------
resource "aws_security_group" "vm_sg" {
  for_each = {
    for v in local.vpcs : v.id => v
    if length([for sn in coalesce(v.subnets, []) : sn if length(coalesce(sn.instances, [])) > 0]) > 0
  }

  name        = "${each.value.name}-vm-sg"
  description = "Security group for VMs in ${each.value.name}"
  vpc_id      = aws_vpc.vpc[each.key].id

  # ICMP dentro de la misma VPC
  ingress {
    description = "ICMP intra-VPC"
    from_port   = -1
    to_port     = -1
    protocol    = "icmp"
    cidr_blocks = [each.value.cidr_block]
  }

  # SSH desde tu IP (usa allowed_ssh_cidr del payload)
  ingress {
    description = "SSH from allowed_ssh_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [try(each.value.allowed_ssh_cidr, "0.0.0.0/32")]
  }

  # SSH desde dentro de la misma VPC
  ingress {
    description = "SSH dentro de la VPC"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [each.value.cidr_block]
  }

  # Salida libre (necesaria para ping saliente y updates del sistema)
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${each.value.name}-vm-sg" }
}

# --- ICMP entre VPCs conectadas por PEERING (activado con allow_cross_vpc_ping=true) ---
resource "aws_security_group_rule" "cross_vpc_ping_peering_a" {
  for_each = {
    for l in [for x in local.links : x if try(lower(x.type), "") == "peering"] :
    "${l.vpc_a_id}--${l.vpc_b_id}" => l
    if local.allow_cross_vpc_ping
  }

  type              = "ingress"
  from_port         = -1
  to_port           = -1
  protocol          = "icmp"
  security_group_id = aws_security_group.vm_sg[each.value.vpc_a_id].id
  cidr_blocks       = [local.vpc_by_id[each.value.vpc_b_id].cidr_block]
  description       = "Allow ICMP from peer ${each.value.vpc_b_id}"
}

resource "aws_security_group_rule" "cross_vpc_ping_peering_b" {
  for_each = {
    for l in [for x in local.links : x if try(lower(x.type), "") == "peering"] :
    "${l.vpc_b_id}--${l.vpc_a_id}" => l
    if local.allow_cross_vpc_ping
  }

  type              = "ingress"
  from_port         = -1
  to_port           = -1
  protocol          = "icmp"
  security_group_id = aws_security_group.vm_sg[each.value.vpc_b_id].id
  cidr_blocks       = [local.vpc_by_id[each.value.vpc_a_id].cidr_block]
  description       = "Allow ICMP from peer ${each.value.vpc_a_id}"
}

# --- ICMP entre VPCs conectadas a un mismo TGW (activado con allow_cross_vpc_ping=true) ---
locals {
  tgw_vpcs_by_router = {
    for r in toset([for l in local.tgw_links : l.router_id]) :
    r => [for l in local.tgw_links : l.vpc_id if l.router_id == r]
  }
  tgw_pairs = flatten([
    for r, vpcs in local.tgw_vpcs_by_router : [
      for i in range(length(vpcs)) : [
        for j in range(i + 1, length(vpcs)) : {
          a = vpcs[i]
          b = vpcs[j]
        }
      ]
    ]
  ])
}

resource "aws_security_group_rule" "cross_vpc_ping_tgw_a" {
  for_each = {
    for p in local.tgw_pairs :
    "${p.a}--${p.b}" => p
    if local.allow_cross_vpc_ping
  }

  type              = "ingress"
  from_port         = -1
  to_port           = -1
  protocol          = "icmp"
  security_group_id = aws_security_group.vm_sg[each.value.a].id
  cidr_blocks       = [local.vpc_by_id[each.value.b].cidr_block]
  description       = "Allow ICMP from TGW-connected VPC ${each.value.b}"
}

resource "aws_security_group_rule" "cross_vpc_ping_tgw_b" {
  for_each = {
    for p in local.tgw_pairs :
    "${p.b}--${p.a}" => p
    if local.allow_cross_vpc_ping
  }

  type              = "ingress"
  from_port         = -1
  to_port           = -1
  protocol          = "icmp"
  security_group_id = aws_security_group.vm_sg[each.value.b].id
  cidr_blocks       = [local.vpc_by_id[each.value.a].cidr_block]
  description       = "Allow ICMP from TGW-connected VPC ${each.value.a}"
}

# ---------------------- EC2 instances ----------------------
resource "aws_instance" "vm" {
  for_each                    = local.inst_map
  ami                         = coalesce(each.value.ami, local.default_ami_id)
  instance_type               = each.value.instance_type
  subnet_id                   = aws_subnet.this[each.value.subnet_key].id
  associate_public_ip_address = each.value.associate_public_ip

  # Si ip_address está vacío o ausente, Terraform omite el atributo y AWS asigna la IP automáticamente.
  private_ip = (
    try(length(trimspace(each.value.ip_address)) > 0, false)
    ? trimspace(each.value.ip_address)
    : null
  )

  key_name               = each.value.ssh_access
  vpc_security_group_ids = [aws_security_group.vm_sg[each.value.vpc_id_key].id]
  tags = {
    Name = each.value.name
  }
}
{% endif %}


# =========================
# IGW / NAT / ROUTE TABLES
# =========================

locals {
  vpc_needs_igw = {
    for v in local.vpcs : v.id => (
      try(v.internet_gateway, false) ||
      try(anytrue([for rt in coalesce(v.route_tables, []) :
        anytrue([for r in coalesce(rt.routes, []) : lower(try(r.target, "")) == "igw"])
      ]), false)
    )
  }
}

resource "aws_internet_gateway" "igw" {
  for_each = { for v in local.vpcs : v.id => v if local.vpc_needs_igw[v.id] }
  vpc_id   = aws_vpc.vpc[each.key].id
  tags     = { Name = "${each.value.name}-igw" }
}

# --- NAT Gateway (1 por VPC habilitada) ---
locals {
  vpc_nat_enabled    = { for v in local.vpcs : v.id => try(v.nat_gateway.enabled, false) }
  vpc_nat_pub_subnet = { for v in local.vpcs : v.id => try(v.nat_gateway.public_subnet, "") }
}

resource "aws_eip" "nat_eip" {
  for_each = { for v in local.vpcs : v.id => v if local.vpc_nat_enabled[v.id] }
  domain   = "vpc"
  tags     = { Name = "${each.value.name}-nat-eip" }
}

resource "aws_nat_gateway" "nat" {
  for_each      = { for v in local.vpcs : v.id => v if local.vpc_nat_enabled[v.id] }
  subnet_id     = aws_subnet.this["${each.key}:${local.vpc_nat_pub_subnet[each.key]}"].id
  allocation_id = aws_eip.nat_eip[each.key].id
  tags          = { Name = "${each.value.name}-nat" }
  depends_on    = [aws_internet_gateway.igw]
}

# =========================
# ROUTE TABLES
# =========================

locals {
  route_tables_flat = flatten([
    for v in local.vpcs : [
      for rt in coalesce(v.route_tables, []) : {
        key        = "${v.id}:${rt.name}"
        vpc_id     = v.id
        vpc_name   = v.name
        rt_name    = rt.name
        routes     = rt.routes
      }
    ]
  ])

  # Para asociaciones robustas (por si no existe "main")
  rt_any_by_vpc = {
    for v in local.vpcs :
    v.id => try([for rt in coalesce(v.route_tables, []) : "${v.id}:${rt.name}"][0], null)
  }

  vpc_has_rt = { for v in local.vpcs : v.id => length(coalesce(v.route_tables, [])) > 0 }
}

resource "aws_route_table" "rt_named" {
  for_each = { for rt in local.route_tables_flat : rt.key => rt }
  vpc_id   = aws_vpc.vpc[each.value.vpc_id].id
  tags     = { Name = "${each.value.vpc_name}-${each.value.rt_name}" }
}

# Asociación de subnets a su RT (solo si la VPC tiene RTs definidos)
resource "aws_route_table_association" "assoc" {
  for_each = {
    for s in local.all_subnets : s.key => s
    if local.vpc_has_rt[s.vpc]
  }

  subnet_id = aws_subnet.this[each.key].id
  route_table_id = coalesce(
    try(aws_route_table.rt_named["${each.value.vpc}:${each.value.data.route_table}"].id, null),
    try(aws_route_table.rt_named[local.rt_any_by_vpc[each.value.vpc]].id, null)
  )
}

# =========================
# RUTAS EXPLÍCITAS (sin 'local')
# =========================

locals {
  routes_flat = flatten([
    for v in local.vpcs : [
      for rt in coalesce(v.route_tables, []) : [
        for r in coalesce(rt.routes, []) : [
          for tgt in [lower(try(r.target, ""))] :
          (contains(["", "local"], tgt) ? null : {
            key        = "${v.id}:${rt.name}:${r.name}"
            vpc_id     = v.id
            rt_name    = rt.name
            dest_cidr  = r.dest_cidr
            target     = tgt
          })
        ]
      ]
    ]
  ])
}

resource "aws_route" "rt_named_routes" {
  for_each = { for r in local.routes_flat : r.key => r if r != null }

  route_table_id         = aws_route_table.rt_named["${each.value.vpc_id}:${each.value.rt_name}"].id
  destination_cidr_block = each.value.dest_cidr

  # IGW
  gateway_id = (
    contains(["igw", "internet-gateway"], each.value.target)
    ? try(aws_internet_gateway.igw[each.value.vpc_id].id, null)
    : null
  )

  # NAT
  nat_gateway_id = (
    contains(["nat", "nat-gw", "natgateway"], each.value.target)
    ? try(aws_nat_gateway.nat[each.value.vpc_id].id, null)
    : null
  )

  # TGW (cuando se definan rutas explícitas a través del TGW)
  transit_gateway_id = (
    contains(["tgw", "transit-gateway"], each.value.target)
    ? try(aws_ec2_transit_gateway.tgw[0].id, null)
    : null
  )
}

# =========================
# NAT default auto-routes (privadas)
# =========================

# ¿Algún RT ya trae 0.0.0.0/0 explícito? (igw o nat)
locals {
  explicit_default_in_rt = {
    for rt in local.route_tables_flat :
    rt.key => anytrue([
      for r in coalesce(rt.routes, []) :
      (try(lower(r.target), "") == "nat" || try(lower(r.target), "") == "igw") &&
      try(r.dest_cidr, "") == "0.0.0.0/0"
    ])
  }
}

# Conjunto de nombres de RT declarados por VPC (datos 100% conocidos en plan)
locals {
  rt_names_by_vpc = {
    for v in local.vpcs :
    v.id => toset([for rt in coalesce(v.route_tables, []) : rt.name])
  }
}

# Candidatos por cada subnet (sin usar attributes de recursos)
locals {
  nat_default_candidates = flatten([
    for s in local.all_subnets : [
      {
        vpc_id    = s.vpc
        is_public = try(s.data.map_public_ip_on_launch, false)
        rt_name   = try(s.data.route_table, null)
      }
    ]
  ])
}

resource "aws_route" "nat_default_auto" {
  for_each = {
    for x in local.nat_default_candidates :
    "${x.vpc_id}:${coalesce(x.rt_name, "__none__")}" => x
    if (
      !x.is_public &&
      local.vpc_nat_enabled[x.vpc_id] &&
      x.rt_name != null &&
      contains(local.rt_names_by_vpc[x.vpc_id], x.rt_name) &&
      !lookup(local.explicit_default_in_rt, "${x.vpc_id}:${x.rt_name}", false)
    )
  }

  route_table_id         = aws_route_table.rt_named["${each.value.vpc_id}:${each.value.rt_name}"].id
  destination_cidr_block = "0.0.0.0/0"
  nat_gateway_id         = aws_nat_gateway.nat[each.value.vpc_id].id
  depends_on             = [aws_nat_gateway.nat]
}

# =========================
# TGW + PEERING
# =========================

resource "aws_ec2_transit_gateway" "tgw" {
  count = length(local.tgw_routers) > 0 ? 1 : 0

  description = try(local.tgw_routers[0].name, "core-tgw")

  # 🔴 Desactivamos asociaciones/propagaciones por defecto
  default_route_table_association = "disable"
  default_route_table_propagation = "disable"

  tags = {
    Name = try(local.tgw_routers[0].name, "core-tgw")
  }
}

resource "aws_ec2_transit_gateway_vpc_attachment" "tgw_attach" {
  for_each = { for l in local.tgw_links : "${l.router_id}:${l.vpc_id}" => l }

  transit_gateway_id = aws_ec2_transit_gateway.tgw[0].id
  vpc_id             = aws_vpc.vpc[each.value.vpc_id].id
  subnet_ids         = [
    for sn in coalesce(each.value.subnet_names, []) :
    aws_subnet.this["${each.value.vpc_id}:${sn}"].id
  ]

  tags = { Name = "tgw-attach-${each.value.vpc_id}" }
}

# -------------------------
# TGW ROUTE TABLE + RUTAS
# -------------------------

# Tabla de ruteo principal del TGW
resource "aws_ec2_transit_gateway_route_table" "tgw_rt" {
  count = length(local.tgw_routers) > 0 ? 1 : 0

  transit_gateway_id = aws_ec2_transit_gateway.tgw[0].id
  tags = {
    Name = "tgw-main-rt"
  }
}

# Asociación de cada attachment a la TGW Route Table (solo manual, sin auto-asociación)
resource "aws_ec2_transit_gateway_route_table_association" "tgw_rt_assoc" {
  for_each = length(local.tgw_routers) > 0 ? aws_ec2_transit_gateway_vpc_attachment.tgw_attach : {}

  transit_gateway_route_table_id = aws_ec2_transit_gateway_route_table.tgw_rt[0].id
  transit_gateway_attachment_id  = each.value.id
}

# Destinos del TGW hacia cada VPC (CIDR completo de cada VPC)
locals {
  tgw_destinations = [
    for v in local.vpcs : {
      cidr = v.cidr_block
      vpc  = v.id
    }
  ]
}

# Rutas en la tabla del TGW hacia cada VPC
resource "aws_ec2_transit_gateway_route" "tgw_to_vpcs" {
  for_each = length(local.tgw_routers) > 0 ? {
    for dest in local.tgw_destinations :
    dest.vpc => dest
  } : {}

  destination_cidr_block         = each.value.cidr
  transit_gateway_route_table_id = aws_ec2_transit_gateway_route_table.tgw_rt[0].id
  transit_gateway_attachment_id  = aws_ec2_transit_gateway_vpc_attachment.tgw_attach[
    "wa18q46a:${each.value.vpc}"
  ].id
}

# =========================
# RUTAS EN LAS VPC HACIA EL TGW
# (a partir de links[].routes.to_router)
# =========================

locals {
  # Para cada link TGW y cada ruta "to_router", generamos una entrada:
  # - vpc_id   = VPC origen
  # - dest_cidr = CIDR de la VPC destino
  # - rt_name  = nombre de la route table donde se instalará la ruta (aquí asumimos "public")
  tgw_vpc_routes = flatten([
    for l in local.tgw_links : [
      for r in coalesce(try(l.routes.to_router, []), []) : {
        key       = "${l.vpc_id}:${r.dest_cidr}"
        vpc_id    = l.vpc_id
        dest_cidr = r.dest_cidr
        rt_name   = "public"
      }
    ]
  ])
}

resource "aws_route" "tgw_routes" {
  for_each = length(local.tgw_routers) > 0 ? {
    for r in local.tgw_vpc_routes :
    r.key => r
  } : {}

  route_table_id         = aws_route_table.rt_named["${each.value.vpc_id}:${each.value.rt_name}"].id
  destination_cidr_block = each.value.dest_cidr
  transit_gateway_id     = aws_ec2_transit_gateway.tgw[0].id
}

# -------------------------
# PEERING
# -------------------------

locals {
  peering_links = [for l in local.links : l if try(lower(l.type), "") == "peering"]

  # PARES (A->B) Y (B->A) PARA TODAS LAS RT DECLARADAS
  peer_a_pairs = flatten([
    for l in local.peering_links : [
      for rt in coalesce(local.vpc_by_id[l.vpc_a_id].route_tables, []) : {
        l  = l
        rt = rt
      }
    ]
  ])
  peer_b_pairs = flatten([
    for l in local.peering_links : [
      for rt in coalesce(local.vpc_by_id[l.vpc_b_id].route_tables, []) : {
        l  = l
        rt = rt
      }
    ]
  ])
}

resource "aws_vpc_peering_connection" "peer" {
  for_each    = { for l in local.peering_links : "${l.vpc_a_id}--${l.vpc_b_id}" => l }
  vpc_id      = aws_vpc.vpc[each.value.vpc_a_id].id
  peer_vpc_id = aws_vpc.vpc[each.value.vpc_b_id].id
  auto_accept = true
  tags        = { Name = "peer-${each.value.vpc_a_id}-${each.value.vpc_b_id}" }
}

# Rutas de peering en TODAS las RT declaradas de cada VPC
resource "aws_route" "peer_a_to_b" {
  for_each = {
    for x in local.peer_a_pairs :
    "a-${x.l.vpc_a_id}-${x.l.vpc_b_id}:${x.rt.name}" => x
  }

  route_table_id            = aws_route_table.rt_named["${each.value.l.vpc_a_id}:${each.value.rt.name}"].id
  destination_cidr_block    = local.vpc_by_id[each.value.l.vpc_b_id].cidr_block
  vpc_peering_connection_id = aws_vpc_peering_connection.peer["${each.value.l.vpc_a_id}--${each.value.l.vpc_b_id}"].id
}

resource "aws_route" "peer_b_to_a" {
  for_each = {
    for x in local.peer_b_pairs :
    "b-${x.l.vpc_a_id}-${x.l.vpc_b_id}:${x.rt.name}" => x
  }

  route_table_id            = aws_route_table.rt_named["${each.value.l.vpc_b_id}:${each.value.rt.name}"].id
  destination_cidr_block    = local.vpc_by_id[each.value.l.vpc_a_id].cidr_block
  vpc_peering_connection_id = aws_vpc_peering_connection.peer["${each.value.l.vpc_a_id}--${each.value.l.vpc_b_id}"].id
}
