          {
            "target": "tgw",
            "dest_cidr": "10.62.0.0/16"
          }
        ]
      }
    },
    {
      "type": "tgw-attach",
      "vpc_id": "vpc-c-05",
      "router_id": "router-tgw-05",
      "subnet_names": ["public-c1"],
      "routes": {
        "to_router": [
          {
            "target": "tgw",
            "dest_cidr": "10.60.0.0/16"
