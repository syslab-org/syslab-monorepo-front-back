          "availability_zone": "us-east-1a",
          "map_public_ip_on_launch": true,
          "route_table": "public",
          "instances": [
            {
              "id": "vm-a1",
              "name": "bastion-a1",
              "ami": "ami-0ebfd941bbafe70c6",
              "instance_type": "t2.micro",
              "ip_address": "10.60.1.10",
