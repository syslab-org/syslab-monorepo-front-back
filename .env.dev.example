# Copia este archivo a .env.dev para una instalacion nueva.
#
# Recomendado:
# - usar el perfil AWS del host montado desde ~/.aws
# - no guardar llaves permanentes dentro de este archivo

AWS_PROFILE=tesis
AWS_DEFAULT_REGION=us-east-1
AWS_SDK_LOAD_CONFIG=1
ALLOW_LOCAL_APPLY=1
KEEP_TF_DIRS=1

# Intent plugin with OpenAI
# Uncomment to enable the LLM-backed provider locally:
# INTENT_PLUGIN_PROVIDER=intent_plugin.providers.openai.OpenAIIntentProvider
# INTENT_PLUGIN_OPENAI_API_KEY=sk-...
# INTENT_PLUGIN_OPENAI_MODEL=gpt-5.5
# INTENT_PLUGIN_OPENAI_REASONING_EFFORT=low
# INTENT_PLUGIN_OPENAI_TEXT_VERBOSITY=low
# INTENT_PLUGIN_OPENAI_TIMEOUT_SECONDS=45

# Solo como ultimo recurso, no recomendado:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
