# ==== Normalización de finales de línea ====
# Fuerza LF en todos los archivos de texto
* text=auto eol=lf

# ==== Archivos específicos ====
# Código fuente
*.js     text eol=lf
*.ts     text eol=lf
*.jsx    text eol=lf
*.tsx    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf

# Archivos que deben quedarse en binario
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.woff   binary
*.woff2  binary

# Terraform
*.tf     text eol=lf
*.tfvars text eol=lf

