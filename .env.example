# Copia este archivo a .env para una instalacion nueva.
#
# Politica recomendada:
# - este archivo de ejemplo puede vivir en git
# - el archivo real .env debe ser local de cada maquina
# - no guardar credenciales AWS ni secretos reales en este archivo versionado

REDIS_URL=redis://redis:6379/0
DEBUG=1
SECRET_KEY=dev-change-me
ALLOWED_HOSTS=*
# DATABASE_URL=sqlite:///db.sqlite3
ALLOW_LOCAL_APPLY=1

# Intent plugin
INTENT_PLUGIN_ENABLED=1
INTENT_PLUGIN_DEFAULT_REGION=us-east-1
INTENT_PLUGIN_MAX_WORKLOADS=6

# Default local provider
INTENT_PLUGIN_PROVIDER=intent_plugin.providers.heuristic.HeuristicIntentProvider

# To enable the OpenAI-backed provider locally, switch the provider path and
# place the API key in .env.dev or another local-only env file:
# INTENT_PLUGIN_PROVIDER=intent_plugin.providers.openai.OpenAIIntentProvider
