@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

actor Usuario

rectangle "Capa de presentación" as PRESENTACION {
  component "Frontend\nReact + Vite\nCanvas visual" as FRONTEND
}

rectangle "Capa lógica" as LOGICA {
  component "Backend API\nDjango + DRF" as BACKEND
  component "Compilación\nmodelo neutral -> payload AWS" as COMPILER
  database "PostgreSQL" as DB
  collections "Redis" as REDIS

  rectangle "Dominio persistido" as DOMINIO {
    component "Lab" as LAB
    component "Plan" as PLAN
    component "CloudConnection" as CLOUD
    component "PlanExecutionRecord" as EXECREC
  }
}

rectangle "Capa de aprovisionamiento" as APROV {
  component "Celery Worker" as CELERY
  component "Terraform" as TF
  cloud "AWS" as AWS
}

Usuario --> FRONTEND : Interacción
FRONTEND --> BACKEND : Crear/editar laboratorio\nconsultar planes\nsolicitar validación/despliegue

BACKEND --> LAB : Persistencia / lectura
BACKEND --> PLAN : Crear / actualizar
BACKEND --> CLOUD : Resolver conexión efectiva
BACKEND --> EXECREC : Registrar historial
BACKEND --> DB : Persistir datos
BACKEND --> REDIS : Encolar tareas

BACKEND --> COMPILER : Compilar intent neutral
COMPILER --> CELERY : Payload AWS + contexto de ejecución

REDIS <--> CELERY : Broker / estado de tareas
CELERY --> TF : plan / apply / destroy
TF --> AWS : Aprovisionamiento real
AWS --> TF : Estado / outputs
TF --> CELERY : Logs / resultados

CELERY --> PLAN : Actualizar estado\nlogs y outputs
CELERY --> EXECREC : Actualizar auditoría
PLAN --> DB
EXECREC --> DB
LAB --> DB
CLOUD --> DB

BACKEND --> FRONTEND : Estado del plan\nlogs\noutputs\nhistorial
FRONTEND --> BACKEND : Polling de estado

@enduml
