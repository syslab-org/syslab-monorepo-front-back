@startuml
title Flujo de la aplicación

skinparam shadowing false
skinparam activityArrowThickness 1.2
skinparam defaultFontName Arial

start

partition "Usuario" {
  :Iniciar sesión;
  :Crear laboratorio;
  :Definir curso / proveedor /\nconexión cloud opcional;
  :Diseñar topología en el canvas;
  :Solicitar validación o despliegue;
}

partition "Frontend" {
  :Construir representación\nestructurada del laboratorio;
  :Sincronizar laboratorio y plan\ncon el backend;
}

partition "Backend API" {
  :Validar estructura recibida;
  :Asegurar Lab persistido;
  :Crear o actualizar Plan;
  :Resolver CloudConnection efectiva;
  :Evaluar permisos de ejecución;
}

if (¿Acción solicitada = validación?) then (Sí)
  partition "Backend API" {
    :Crear PlanExecutionRecord;
    :Encolar tarea de preview;
  }

  partition "Celery / Terraform / AWS" {
    :Ejecutar terraform plan;
    :Capturar logs y estado;
  }

  partition "Backend API" {
    :Persistir estado, logs\ny resultados del preview;
  }

else (No, despliegue o destroy)

  if (¿Rol autorizado?) then (Sí)
    partition "Backend API" {
      :Construir credenciales runtime;
      :Registrar contexto de ejecución;
      :Crear PlanExecutionRecord;
      :Encolar tarea real;
    }

    if (¿Acción = despliegue?) then (Deploy)
      partition "Celery / Terraform / AWS" {
        :Ejecutar terraform apply;
        :Aprovisionar infraestructura en AWS;
        :Capturar outputs, logs\ny contexto cloud;
      }
    else (Destroy)
      partition "Celery / Terraform / AWS" {
        :Ejecutar terraform destroy;
        :Eliminar infraestructura en AWS;
        :Capturar logs y estado final;
      }
    endif

    partition "Backend API" {
      :Persistir outputs, logs,\nestado e historial;
    }

  else (No)
    partition "Backend API" {
      :Rechazar ejecución real;
      :Responder error de permisos;
    }
  endif
endif

partition "Frontend" {
  :Consultar periódicamente\nel estado del plan;
  :Mostrar estado, logs,\noutputs e historial;
}

partition "Usuario" {
  if (¿Perfil del usuario?) then (Estudiante)
    :Opera sobre sus propios\nlaboratorios;
  elseif (Docente)
    :Puede revisar laboratorios\ndel curso y ejecutar solo si la\nconexión efectiva es course_shared\n o existe delegación explícita;
  else (Admin)
    :Puede operar globalmente\nsobre cualquier plan;
  endif
}

stop
@enduml
