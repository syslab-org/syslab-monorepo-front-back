flowchart TD
    A[Frontend / Canvas] --> B[POST sync-from-canvas]
    B --> C[PlanViewSet.sync_from_canvas]
    C --> D[_sanitize_payload_for_storage]
    D --> E[validate_network_plan]
    E --> F[normalize_network_intent]
    F --> G[get_provider_adapter]
    G --> H[AwsProviderAdapter.compile]
    H --> I[MultiPlanSerializer]
    C --> J[ensure_lab_for_canvas]
    J --> K[Plan create/update]
    K --> L[Plan en PENDING]

    L --> M[POST deploy]
    M --> N[deploy_plan]
    N --> O[Permisos, cloud target, drift, runtime]
    O --> P[PlanExecutionRecord]
    P --> Q[process_network_plan.delay]

    Q --> R[Celery queue]
    R --> S[Celery worker]
    S --> T[process_network_plan]
    T --> U[get_provider_executor]
    U --> V[AwsProviderExecutor.build_bundle]
    V --> W[prepare_workspace]
    W --> X[render_workspace]
    T --> Y[preflight_apply]
    T --> Z[terraform init]
    T --> AA[terraform plan]
    T --> AB[terraform apply si simulate_only=False]
    T --> AC[read outputs]
    T --> AD[mark_success o mark_failure]
    AD --> AE[Plan final]
